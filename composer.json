{
  "name": "goletter/hyperf-docs",
  "description": "Hyperf Docs integration for Google Docs/Sheets/Drive and Tencent Docs",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "goletter",
      "email": "goletter@outlook.com"
    }
  ],
  "keywords": [
    "php",
    "hyperf",
    "google",
    "tencent",
    "sheets",
    "docs",
    "drive"
  ],
  "require": {
    "php": ">=8.1",
    "google/apiclient": "^2.19",
    "guzzlehttp/guzzle": "^7.0",
    "hyperf/command": "~3.1.0",
    "hyperf/contract": "~3.1.0",
    "hyperf/di": "~3.1.0"
  },
  "autoload": {
    "psr-4": {
      "Goletter\\Docs\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Goletter\\Docs\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "3.1-dev"
    },
    "hyperf": {
      "config": "Goletter\\Docs\\ConfigProvider"
    }
  },
  "scripts": {
    "analyse": "phpstan analyse --memory-limit 300M -l 0 ./src",
    "cs-fix": "php-cs-fixer fix $1",
    "test": "co-phpunit -c phpunit.xml --colors=always"
  }
}
